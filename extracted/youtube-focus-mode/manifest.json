{
  "manifest_version": 3,
  "name": "NYC YouTube Focus Mode",
  "version": "1.0",
  "description": "Hide distractions on YouTube while you study.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "css": ["focus.css"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}